{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 27, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_CXX_STANDARD": "23",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "core-debug",
      "displayName": "Core + tests (Debug, no Qt)",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "AD_BUILD_CLIENT": "OFF",
        "AD_BUILD_TESTS": "ON"
      }
    },
    {
      "name": "core-release",
      "displayName": "Core + tests (Release, no Qt) - for the AI benchmarks",
      "inherits": "core-debug",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    },
    {
      "name": "core-asan",
      "displayName": "Core + tests (ASan/UBSan)",
      "inherits": "core-debug",
      "cacheVariables": {
        "CMAKE_CXX_FLAGS": "-fsanitize=address,undefined -fno-omit-frame-pointer"
      }
    },
    {
      "name": "desktop-debug",
      "displayName": "Desktop (Debug, Qt client + tests)",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "AD_REQUIRE_QT": "ON",
        "CMAKE_PREFIX_PATH": "$env{QT_ROOT_DIR}"
      }
    },
    {
      "name": "desktop-release",
      "displayName": "Desktop (Release)",
      "inherits": "desktop-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "AD_BUILD_TESTS": "OFF"
      }
    }
  ],
  "buildPresets": [
    { "name": "core-debug",      "configurePreset": "core-debug" },
    { "name": "core-release",    "configurePreset": "core-release" },
    { "name": "core-asan",       "configurePreset": "core-asan" },
    { "name": "desktop-debug",   "configurePreset": "desktop-debug" },
    { "name": "desktop-release", "configurePreset": "desktop-release" }
  ],
  "testPresets": [
    { "name": "core-debug",    "configurePreset": "core-debug",    "output": { "outputOnFailure": true } },
    { "name": "core-release",  "configurePreset": "core-release",  "output": { "outputOnFailure": true } },
    { "name": "core-asan",     "configurePreset": "core-asan",     "output": { "outputOnFailure": true } },
    { "name": "desktop-debug", "configurePreset": "desktop-debug", "output": { "outputOnFailure": true } }
  ]
}
